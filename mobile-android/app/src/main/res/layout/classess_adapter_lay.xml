<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="match_parent"

    >

    <TextView
        android:id="@+id/classess"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:fontFamily="@font/mandali"
        android:textSize="17dp"
        android:maxLines="1"
        android:textStyle="bold"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="12dp"
        />

    <TextView
        android:id="@+id/count_student"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:fontFamily="@font/de"
        android:textStyle="italic"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/update"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:drawableLeft="@drawable/ic_pencil"
        android:drawablePadding="2dp"
        android:paddingLeft="12dp"
        android:paddingRight="30dp"
        android:background="@drawable/border_update"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/delete"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:drawableLeft="@drawable/ic_delete"
        android:drawablePadding="2dp"
        android:paddingLeft="12dp"
        android:paddingRight="30dp"
        android:background="@drawable/border_remove"
        android:layout_marginTop="12dp"/>


</LinearLayout>