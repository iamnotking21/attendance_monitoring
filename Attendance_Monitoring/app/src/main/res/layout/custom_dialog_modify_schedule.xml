<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="15dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView15"
            android:layout_width="230dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="16dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"
            android:text="Update Schedule" />


        <Button
            android:id="@+id/remove"
            android:layout_width="10dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_delete"
            android:drawablePadding="2dp"

            android:paddingRight="30dp"
            android:background="@drawable/border_update"
            />

    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:text="Title:"
            android:textSize="16dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"
            />

        <EditText
            android:id="@+id/titles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".7"
            android:hint="                                                      *"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:text="Venue:"
            android:textSize="16dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>

        <EditText
            android:id="@+id/venues"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".7"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/title_una"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:text="Start:                      "
            android:textSize="16dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>


        <TextView
            android:id="@+id/una"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="16dp"
            android:gravity="center"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>

        <Button
            android:id="@+id/update_start"
            android:layout_width="20dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_alarm_clock"
            android:drawablePadding="2dp"
            android:paddingLeft="25dp"
            android:paddingRight="30dp"
            android:background="@drawable/border_update"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/title_tapos"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:text="End:                      "
            android:textSize="16dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>


        <TextView
            android:id="@+id/tapos"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="16dp"
            android:gravity="center"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>

        <Button
            android:id="@+id/update_end"
            android:layout_width="20dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_alarm_clock"
            android:drawablePadding="2dp"
            android:paddingLeft="25dp"
            android:paddingRight="30dp"
            android:background="@drawable/border_update"
            />
    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/before_late"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:text="Mins Before Late:"
            android:textSize="13dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>


        <TextView
            android:id="@+id/min_late_start"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="13dp"
            android:gravity="left"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>

        <TextView
            android:id="@+id/min_late_end"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="13dp"
            android:gravity="right"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>


        <Button
            android:id="@+id/late"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_alarm_clock"
            android:drawablePadding="2dp"
            android:paddingLeft="20dp"
            android:paddingRight="30dp"
            android:background="@drawable/border_update"
            />
    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/time_start"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight=".3"
            android:textSize="18dp"
            android:visibility="invisible"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"
            />

        <TextView
            android:id="@+id/time_end"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight=".3"
            android:textSize="18dp"
            android:visibility="invisible"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"
            />

    </LinearLayout>



</LinearLayout>