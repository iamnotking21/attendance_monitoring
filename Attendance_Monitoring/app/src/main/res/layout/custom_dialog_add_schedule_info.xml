<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/section_namex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="18dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/una"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="18dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"
            />

        <TextView
            android:id="@+id/tapos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="18dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:text="Title:"
            android:textSize="16dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"
            />

        <EditText
            android:id="@+id/titles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".7"
            android:hint="                                                      *"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:text="Venue:"
            android:textSize="16dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>

        <EditText
            android:id="@+id/venues"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".7"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/before_late"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:text="Mins Before Late:"
            android:textSize="13dp"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>


        <TextView
            android:id="@+id/min_late_start"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="13dp"
            android:gravity="left"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>

        <TextView
            android:id="@+id/min_late_end"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_weight=".3"
            android:textSize="13dp"
            android:gravity="right"
            android:textStyle="bold"
            android:fontFamily="@font/mandali"/>


        <Button
            android:id="@+id/late"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_alarm"
            android:drawablePadding="2dp"
            android:paddingLeft="20dp"
            android:paddingRight="30dp"
            android:background="@drawable/border_update"
            />
    </LinearLayout>

</LinearLayout>